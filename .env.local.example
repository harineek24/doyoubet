# Supabase (Postgres + Auth + Storage)
# Create a project at https://supabase.com, enable Google as an Auth provider,
# then fill these in. The app runs on local mock data until these are set.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Tavily Search API (server-side only, never exposed to the browser)
# https://app.tavily.com/sign-up
TAVILY_API_KEY=

# Groq API — primary LLM for subject generation (fast, free tier available)
# https://console.groq.com — create a free API key
# If unset, falls back to a local Ollama instance (OLLAMA_BASE_URL below)
GROQ_API_KEY=

# Ollama (optional fallback if GROQ_API_KEY is not set)
# Run locally with: ollama serve  (https://ollama.com)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest
