# Supabase (Postgres + Auth + Storage)
# Create a project at https://supabase.com, enable Google as an Auth provider,
# then fill these in. The app runs on local mock data until these are set.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google Programmable Search (server-side only, never exposed to the browser)
# https://programmablesearchengine.google.com + Custom Search JSON API key
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
